[{"id": 1, "level": "starter", "title": "الأصوات الأولى", "kind": "أصوات وحروف", "focus": "a / s / t / p", "words": ["a", "s", "t", "p"], "questions": [{"q": "أي حرف يصدر صوت /s/؟", "a": "s", "options": ["a", "p", "s"]}, {"q": "اختر الحرف p", "a": "p", "options": ["t", "p", "a"]}], "mission": "قل أصوات الحروف الأربعة بصوت واضح", "stage": "🌱 التأسيس", "goal": "أستطيع قراءة الكلمات واستخدامها في عبارة بسيطة", "resources": "https://learnenglishkids.britishcouncil.org/"}, {"id": 2, "level": "starter", "title": "أقرأ أول كلمة", "kind": "الدمج الصوتي", "focus": "sat · at · pat", "words": ["sat", "at", "pat"], "questions": [{"q": "ما الكلمة المكتوبة sat؟", "a": "sat", "options": ["tap", "sat", "pat"]}, {"q": "رتب أصوات /a/ /t/", "a": "at", "options": ["at", "ta", "ap"]}], "mission": "اقرأ sat و at ثم سجّل صوتك", "stage": "🌱 التأسيس", "goal": "أستطيع قراءة الكلمات واستخدامها في عبارة بسيطة", "resources": "https://learnenglishkids.britishcouncil.org/"}, {"id": 3, "level": "starter", "title": "أشياء حولي", "kind": "مفردات", "focus": "book · pen · bag · desk", "words": ["book", "pen", "bag", "desk"], "questions": [{"q": "What is this? 📚", "a": "book", "options": ["bag", "pen", "book"]}, {"q": "اختر معنى pen", "a": "قلم", "options": ["قلم", "كرسي", "حقيبة"]}], "mission": "سمِّ ثلاثة أشياء حولك بالإنجليزية", "stage": "🌱 التأسيس", "goal": "أستطيع قراءة الكلمات واستخدامها في عبارة بسيطة", "resources": "https://learnenglishkids.britishcouncil.org/"}, {"id": 4, "level": "starter", "title": "ألوان وأرقام", "kind": "مفردات", "focus": "red · blue · green · one · two", "words": ["red", "blue", "green", "one", "two"], "questions": [{"q": "What color is 🔴?", "a": "red", "options": ["green", "red", "blue"]}, {"q": "What comes after one?", "a": "two", "options": ["three", "ten", "two"]}], "mission": "اعثر على شيئين أحمر وأزرق", "stage": "🌱 التأسيس", "goal": "أستطيع قراءة الكلمات واستخدامها في عبارة بسيطة", "resources": "https://learnenglishkids.britishcouncil.org/"}, {"id": 5, "level": "sta