ast · questions", "words": ["I am studying.", "I studied yesterday.", "Do you study?"], "questions": [{"q": "Yesterday = ", "a": "الماضي", "options": ["الماضي", "الآن", "المستقبل"]}, {"q": "I am ___.", "a": "studying", "options": ["study", "studies", "studying"]}], "mission": "سجّل دقيقة تتحدث فيها عن يومك", "stage": "🧭 التواصل", "goal": "أستطيع فهم العبارات وتوظيفها في حديث قصير", "resources": "https://learnenglishteens.britishcouncil.org/"}, {"id": 17, "level": "advanced", "title": "أعبر عن رأيي", "kind": "رأي وحجج", "focus": "I think · because · however", "words": ["I think reading is useful.", "I like it because it is fun.", "However, it takes time."], "questions": [{"q": "I like it ___ it is fun.", "a": "because", "options": ["however", "because", "although"]}, {"q": "Choose a contrast word", "a": "however", "options": ["because", "also", "however"]}], "mission": "تحدث لمدة دقيقة عن لعبتك المفضلة", "stage": "🚀 التعبير", "goal": "أستطيع التعبير عن فكرتي بطريقة واضحة", "resources": "https://learnenglishteens.britishcouncil.org/"}, {"id": 18, "level": "advanced", "title": "مقارنة الخيارات", "kind": "مقارنات", "focus": "better than · more useful", "words": ["Reading is better than guessing.", "This method is more useful."], "questions": [{"q": "This is ___ than that.", "a": "better", "options": ["good", "better", "best"]}, {"q": "more ___", "a": "useful", "options": ["useful", "use", "uses"]}], "mission": "قارن بين رياضتين في أربع جمل", "stage": "🚀 التعبير", "goal": "أستطيع التعبير عن فكرتي بطريقة واضحة", "resources": "https://learnenglishteens.britishcouncil.org/"}, {"id": 19, "level": "advanced", "title": "مواقف وحلول", "kind": "حل المشكلات", "focus": "problem · solution · suggest", "words": ["We have a problem.", "I suggest another way.", "This solution may work."], "questions": [{"q": "I ___ another way.", "a": "suggest", "options": ["suggest", "suggests", "suggested to"]}, {"q": "A possible ___", "a": "solution", "options": ["problematic", "solution", "solve"]