rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // استبدل FIREBASE_PARENT_UID بمعرّف ولي الأمر من Authentication > Users.
    // تُرفض جميع عمليات القراءة والكتابة حتى تقوم بالاستبدال والنشر.
    match /families/{familyId} {
      allow read, write: if request.auth != null
        && request.auth.uid == "FIREBASE_PARENT_UID"
        && familyId == request.auth.uid
        && (request.method == 'get' || request.method == 'list' || request.resource == null || (
          request.resource.data.keys().hasOnly(['version','db','life','updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.db is map
          && request.resource.data.life is map
        ));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
